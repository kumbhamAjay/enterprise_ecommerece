PORT=5000

DATABASE_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=
# Stripe (test mode). Secret + publishable keys: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...   # STRIPE_PUBLIC_KEY works too
# Webhook signing secret: `stripe listen --forward-to localhost:5000/api/payments/webhook` prints whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Redis (cache, rate limiting, token revocation). The app still works without it, just uncached and unthrottled.
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (product image uploads). Dashboard -> Settings -> API Keys. Never put the secret in the frontend.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=...

# Email (Resend). Without a key, emails are printed to the server console instead of sent.
RESEND_API_KEY=re_...
EMAIL_FROM="ShopEasy <onboarding@resend.dev>"
# Where links in emails point (the storefront)
APP_URL=http://localhost:5001
# Bull Board queue dashboard at /api/admin/queues (HTTP basic auth, user "admin"). Disabled when unset.
BULL_BOARD_PASSWORD=
# Set to "false" to run the background workers in a separate process: `npm run worker`
RUN_WORKERS=true

# Database tuning (all optional)
# PG_POOL_MAX=10                 # keep (instances x this) under the pooler limit (Supabase session mode: 15)
# PG_CONNECT_TIMEOUT_MS=5000     # waiting longer than this for a free connection -> 503 "server busy"
# PG_STATEMENT_TIMEOUT_MS=15000  # a query running longer than this is cancelled
# SLOW_QUERY_MS=250              # queries slower than this are logged (SQL text only)
# DATABASE_SSL=false             # for a local Postgres without SSL (the benchmark database)
